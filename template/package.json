{
  "name": "expo-kit-template",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@timothyrusso/effect-core": "^0.1.1",
    "effect": "^3.22.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testing-library/react-native": "^14.0.1",
    "@timothyrusso/arch-rules": "^0.1.1",
    "@timothyrusso/config-presets": "^0.1.1",
    "@timothyrusso/eslint-plugin-arch": "^0.1.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lefthook": "^2.1.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "biome check . && eslint .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:text": "config-presets check-text",
    "check:arch": "config-presets check-deps",
    "check:i18n": "config-presets check-i18n",
    "check:unused-keys": "config-presets check-unused-keys",
    "check:hooks": "config-presets check-hooks",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm run check:text && npm run check:arch && npm run check:i18n && npm run check:unused-keys && npm run check:hooks && npm run test",
    "prepare": "lefthook install",
    "arch": "config-presets check-deps && eslint .",
    "arch:fixtures": "node scripts/check-fixtures.mjs"
  },
  "private": true
}
