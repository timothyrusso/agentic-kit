{
  "name": "agentic-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared architecture for agent-driven Expo apps: Claude Code plugin, lint rules, config presets and effect-core",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "check": "npm run lint && npm run check:text && npm run check:schema && npm run check:deps && npm run typecheck && npm run test",
    "lint": "biome check . && npm run build:lint-plugin && eslint .",
    "format": "biome check --write .",
    "check:text": "node scripts/check-text.js",
    "check:schema": "node scripts/sync-schema.js --check",
    "check:deps": "depcruise packages --config .dependency-cruiser.js",
    "sync:schema": "node scripts/sync-schema.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "release": "node scripts/release.js",
    "prepare": "lefthook install && npm run build:lint-plugin",
    "build:lint-plugin": "npm run build -w @timothyrusso/eslint-plugin-arch",
    "smoke:presets": "node scripts/smoke-presets.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "lefthook": "^2.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "yaml": "^2.9.1"
  }
}
